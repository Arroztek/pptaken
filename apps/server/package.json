{
  "name": "@pptaken/server",
  "version": "0.1.0",
  "private": true,
  "description": "PPTaken server: composes Hono, the panel API, the MCP endpoint, the content routes and the adapters.",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "bin": {
    "pptaken": "dist/main.js"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "start": "node dist/main.js",
    "test": "vitest run --testTimeout=30000",
    "test:browser": "pnpm run build && node browser/run.mjs",
    "test:e2e-ui": "pnpm build && node browser/ui-e2e.mjs"
  },
  "dependencies": {
    "@hono/node-server": "2.1.8",
    "@modelcontextprotocol/server": "2.4.0",
    "@pptaken/auth-local": "workspace:*",
    "@pptaken/blob-fs": "workspace:*",
    "@pptaken/core": "workspace:*",
    "@pptaken/mcp": "workspace:*",
    "@pptaken/player": "workspace:*",
    "@pptaken/schema": "workspace:*",
    "@pptaken/storage-sqlite": "workspace:*",
    "hono": "4.13.18",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@pptaken/testing": "workspace:*",
    "@types/node": "22.20.5",
    "tsx": "4.23.15",
    "vitest": "5.1.0"
  }
}
