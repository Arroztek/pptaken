{
  "name": "@pptaken/web",
  "version": "0.0.0",
  "private": true,
  "description": "PPTaken owner panel: first-run setup, Connect your agent, presentations, access & connections and security.",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/bundle-size.mjs",
    "mock": "node test/mock-server.mjs",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json --threshold error",
    "test": "vitest run",
    "test:browser": "pnpm run build && playwright test"
  },
  "dependencies": {
    "@pptaken/ui": "workspace:*"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/node": "22.20.5",
    "svelte": "5.57.3",
    "svelte-check": "4.7.8",
    "typescript": "5.9.3",
    "vite": "8.3.8"
  }
}
