[
  {
    "name": "whoami",
    "title": "Who am I",
    "description": "Checks the connection: returns the PPTaken instance, its base URL, your token's scopes and the current limits. Call it to test the connection or when a scope error is unclear. It does not create or read presentations.",
    "inputSchema": {
      "type": "object",
      "properties": {},
      "additionalProperties": false
    },
    "annotations": {
      "title": "Who am I",
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    }
  },
  {
    "name": "get_authoring_guide",
    "title": "Get the authoring guide",
    "description": "Returns the deck authoring guide: canvas size, allowed HTML/CSS/SVG, reveal steps, fonts, images, limits and an example slide. Call it once before your first create_presentation or update_slides in a session. Do not call it repeatedly; it does not change during a session.",
    "inputSchema": {
      "type": "object",
      "properties": {},
      "additionalProperties": false
    },
    "annotations": {
      "title": "Get the authoring guide",
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    }
  },
  {
    "name": "create_presentation",
    "title": "Create a presentation",
    "description": "Use only when the user wants the presentation in PPTaken (do not use it for a plain request to make a presentation). Creates a complete presentation in one call (all slides) and returns presentation_id, revision 1 and urls; give urls.present to the user. Call get_authoring_guide first. Use idempotency_key so a retry does not create a duplicate. To change an existing presentation use update_slides or update_presentation instead. Images: create first, then add_asset and update_slides.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "description": "Presentation title."
        },
        "lang": {
          "type": "string",
          "pattern": "^[A-Za-z]{2,3}(-[A-Za-z0-9]{2,8})*$",
          "description": "BCP-47 language tag, e.g. \"en\" or \"es-PE\"."
        },
        "aspect_ratio": {
          "description": "\"16:9\" (default, 1920×1080 canvas) or \"4:3\" (1440×1080).",
          "type": "string",
          "enum": [
            "16:9",
            "4:3"
          ]
        },
        "theme": {
          "type": "object",
          "properties": {
            "css": {
              "description": "CSS shared by all slides (classes you reuse). Max 64 KB. @import url(https://…) and url(https://…) are vendored.",
              "type": "string",
              "maxLength": 65536
            },
            "fonts": {
              "description": "Bundled font families the deck uses (max 4). Any other family: use google_fonts or a stylesheet URL.",
              "maxItems": 4,
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "Inter",
                  "IBM Plex Sans",
                  "Bricolage Grotesque",
                  "Space Grotesk",
                  "Source Serif 4",
                  "Fraunces",
                  "JetBrains Mono",
                  "IBM Plex Mono",
                  "Atkinson Hyperlegible"
                ]
              }
            },
            "google_fonts": {
              "description": "Families to vendor from Google Fonts, e.g. [{ \"family\": \"Lora\", \"weights\": [400, 700] }]. The server downloads them once and stores them; then use the family name in CSS.",
              "maxItems": 8,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "family": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9 ]{0,63}$"
                  },
                  "weights": {
                    "minItems": 1,
                    "maxItems": 9,
                    "type": "array",
                    "items": {
                      "type": "integer",
                      "minimum": 100,
                      "maximum": 900
                    }
                  },
                  "italic": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "family"
                ],
                "additionalProperties": false
              }
            },
            "font_faces": {
              "description": "Vendored font faces as get_presentation returns them; send them back unchanged.",
              "maxItems": 96,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "family": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9 _.-]{0,63}$"
                  },
                  "src": {
                    "type": "string",
                    "pattern": "^asset:[0-9a-f]{64}$"
                  },
                  "format": {
                    "type": "string",
                    "enum": [
                      "woff2",
                      "woff",
                      "truetype",
                      "opentype"
                    ]
                  },
                  "weight": {
                    "type": "string",
                    "pattern": "^[1-9][0-9]{0,2}(?: [1-9][0-9]{0,2})?$"
                  },
                  "style": {
                    "type": "string",
                    "enum": [
                      "normal",
                      "italic",
                      "oblique"
                    ]
                  },
                  "unicodeRange": {
                    "type": "string",
                    "maxLength": 4000,
                    "pattern": "^U\\+[0-9A-Fa-f?]{1,6}(?:-[0-9A-Fa-f]{1,6})?(?:, ?U\\+[0-9A-Fa-f?]{1,6}(?:-[0-9A-Fa-f]{1,6})?)*$"
                  },
                  "source": {
                    "type": "string",
                    "maxLength": 2048,
                    "pattern": "^https:\\/\\/[^\\s\"'<>\\\\]+$"
                  }
                },
                "required": [
                  "family",
                  "src",
                  "format"
                ],
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false,
          "description": "Theme shared by all slides."
        },
        "libs": {
          "maxItems": 16,
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "uplot@1"
                ]
              },
              {
                "type": "string",
                "maxLength": 2048,
                "pattern": "^https:\\/\\/\\S+$"
              },
              {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9@/._+-]{1,80}$"
                  },
                  "version": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9._+-]{1,40}$"
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  "source": {
                    "type": "string",
                    "maxLength": 2048,
                    "pattern": "^https:\\/\\/[^\\s\"'<>\\\\]+$"
                  },
                  "finalUrl": {
                    "type": "string",
                    "maxLength": 2048,
                    "pattern": "^https:\\/\\/[^\\s\"'<>\\\\]+$"
                  },
                  "bytes": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 67108864
                  }
                },
                "required": [
                  "name",
                  "sha256"
                ],
                "additionalProperties": false
              }
            ]
          },
          "description": "Interactive mode: scripts loaded before the deck and slide scripts, in order: an https CDN URL of a classic (UMD/IIFE) build, which the server downloads once and stores (vendoring); a bundled id (see the guide); or { name, version, sha256, source } as get_presentation returns it."
        },
        "script": {
          "type": "string",
          "minLength": 1,
          "maxLength": 524288,
          "description": "Interactive mode: deck-level JavaScript run once in the global scope, after libs and before the slide scripts, only after the owner approves it. Max 512 KB."
        },
        "slides": {
          "minItems": 1,
          "maxItems": 200,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9-]{1,40}$",
                "description": "Stable slide id, [a-z0-9-]{1,40}. Generated if missing; keep it to edit the slide later."
              },
              "title": {
                "description": "Short slide title for the overview and the speaker view.",
                "type": "string",
                "maxLength": 200
              },
              "html": {
                "type": "string",
                "maxLength": 262144,
                "description": "Slide content for the fixed canvas (1920×1080 px for 16:9). data-step=\"n\" marks elements revealed on click. Max 256 KB."
              },
              "css": {
                "description": "CSS scoped to this slide. Max 64 KB.",
                "type": "string",
                "maxLength": 65536
              },
              "notes": {
                "description": "Speaker notes in Markdown. Never shown to the audience. Max 16 KB.",
                "type": "string",
                "maxLength": 16384
              },
              "section": {
                "description": "Groups slides in the overview, e.g. \"Intro\".",
                "type": "string",
                "maxLength": 100
              },
              "duration_hint_sec": {
                "description": "Planned seconds for this slide (speaker clock).",
                "type": "integer",
                "minimum": 1,
                "maximum": 3600
              },
              "script": {
                "type": "string",
                "minLength": 1,
                "maxLength": 131072,
                "description": "Interactive mode: the slide's JavaScript, run only after the owner approves it (see the guide). Max 128 KB."
              }
            },
            "required": [
              "html"
            ],
            "additionalProperties": false
          },
          "description": "All the slides, in order (1 to 200)."
        },
        "target_minutes": {
          "description": "Target length of the talk in minutes.",
          "type": "integer",
          "minimum": 1,
          "maximum": 600
        },
        "idempotency_key": {
          "description": "Any unique string. Repeating the call with the same key returns the first result instead of creating a duplicate.",
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      },
      "required": [
        "title",
        "slides"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "title": "Create a presentation",
      "readOnlyHint": false,
      "destructiveHint": false,
      "idempotentHint": false,
      "openWorldHint": false
    }
  },
  {
    "name": "list_presentations",
    "title": "List presentations",
    "description": "Lists presentations, newest first, with optional title search and pagination (next_cursor). Use it to find a presentation_id. It returns no slide content: call get_presentation for that. Presentations in the trash are not listed.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "query": {
          "description": "Case-insensitive text to find in titles.",
          "type": "string",
          "maxLength": 200
        },
        "cursor": {
          "description": "`next_cursor` from the previous page.",
          "type": "string",
          "maxLength": 200
        },
        "limit": {
          "description": "Page size, 1 to 100 (default 20).",
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      },
      "additionalProperties": false
    },
    "annotations": {
      "title": "List presentations",
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    }
  },
  {
    "name": "get_presentation",
    "title": "Get a presentation",
    "description": "Reads a presentation. By default returns the outline (slide ids, titles, sections, step counts) and the current revision, which you need as expected_revision for edits. Ask for \"slides\" (html/css) only for the slides you will edit, using slide_ids, to keep the response small; \"notes\" returns speaker notes; \"theme\" the theme.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "presentation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "description": "Id returned by create_presentation or list_presentations."
        },
        "include": {
          "description": "Parts to return. Default [\"outline\"] (ids, titles, steps). \"slides\" returns html/css (large: combine with slide_ids), \"notes\" the speaker notes, \"theme\" the theme.",
          "maxItems": 4,
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "outline",
              "theme",
              "slides",
              "notes"
            ]
          }
        },
        "slide_ids": {
          "description": "Limit \"slides\" and \"notes\" to these slide ids.",
          "maxItems": 200,
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 40
          }
        }
      },
      "required": [
        "presentation_id"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "title": "Get a presentation",
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    }
  },
  {
    "name": "update_presentation",
    "title": "Update presentation metadata",
    "description": "Changes the title, language, aspect ratio, theme (replaced as a whole) or target minutes, or reorders slides (slide_order must list every current id once). Requires expected_revision from get_presentation. To edit slide content use update_slides instead.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "presentation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "description": "Id returned by create_presentation or list_presentations."
        },
        "expected_revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991,
          "description": "The revision you last read (get_presentation `revision`). The call fails with REVISION_CONFLICT if someone changed the presentation since."
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "lang": {
          "description": "BCP-47 tag; null removes it.",
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z]{2,3}(-[A-Za-z0-9]{2,8})*$",
              "description": "BCP-47 language tag, e.g. \"en\" or \"es-PE\"."
            },
            {
              "type": "null"
            }
          ]
        },
        "aspect_ratio": {
          "type": "string",
          "enum": [
            "16:9",
            "4:3"
          ]
        },
        "theme": {
          "description": "Replaces the whole theme; null removes it.",
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "css": {
                  "description": "CSS shared by all slides (classes you reuse). Max 64 KB. @import url(https://…) and url(https://…) are vendored.",
                  "type": "string",
                  "maxLength": 65536
                },
                "fonts": {
                  "description": "Bundled font families the deck uses (max 4). Any other family: use google_fonts or a stylesheet URL.",
                  "maxItems": 4,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "enum": [
                      "Inter",
                      "IBM Plex Sans",
                      "Bricolage Grotesque",
                      "Space Grotesk",
                      "Source Serif 4",
                      "Fraunces",
                      "JetBrains Mono",
                      "IBM Plex Mono",
                      "Atkinson Hyperlegible"
                    ]
                  }
                },
                "google_fonts": {
                  "description": "Families to vendor from Google Fonts, e.g. [{ \"family\": \"Lora\", \"weights\": [400, 700] }]. The server downloads them once and stores them; then use the family name in CSS.",
                  "maxItems": 8,
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "family": {
                        "type": "string",
                        "pattern": "^[A-Za-z0-9][A-Za-z0-9 ]{0,63}$"
                      },
                      "weights": {
                        "minItems": 1,
                        "maxItems": 9,
                        "type": "array",
                        "items": {
                          "type": "integer",
                          "minimum": 100,
                          "maximum": 900
                        }
                      },
                      "italic": {
                        "type": "boolean"
                      }
                    },
                    "required": [
                      "family"
                    ],
                    "additionalProperties": false
                  }
                },
                "font_faces": {
                  "description": "Vendored font faces as get_presentation returns them; send them back unchanged.",
                  "maxItems": 96,
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "family": {
                        "type": "string",
                        "pattern": "^[A-Za-z0-9][A-Za-z0-9 _.-]{0,63}$"
                      },
                      "src": {
                        "type": "string",
                        "pattern": "^asset:[0-9a-f]{64}$"
                      },
                      "format": {
                        "type": "string",
                        "enum": [
                          "woff2",
                          "woff",
                          "truetype",
                          "opentype"
                        ]
                      },
                      "weight": {
                        "type": "string",
                        "pattern": "^[1-9][0-9]{0,2}(?: [1-9][0-9]{0,2})?$"
                      },
                      "style": {
                        "type": "string",
                        "enum": [
                          "normal",
                          "italic",
                          "oblique"
                        ]
                      },
                      "unicodeRange": {
                        "type": "string",
                        "maxLength": 4000,
                        "pattern": "^U\\+[0-9A-Fa-f?]{1,6}(?:-[0-9A-Fa-f]{1,6})?(?:, ?U\\+[0-9A-Fa-f?]{1,6}(?:-[0-9A-Fa-f]{1,6})?)*$"
                      },
                      "source": {
                        "type": "string",
                        "maxLength": 2048,
                        "pattern": "^https:\\/\\/[^\\s\"'<>\\\\]+$"
                      }
                    },
                    "required": [
                      "family",
                      "src",
                      "format"
                    ],
                    "additionalProperties": false
                  }
                }
              },
              "additionalProperties": false,
              "description": "Theme shared by all slides."
            },
            {
              "type": "null"
            }
          ]
        },
        "target_minutes": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 600
            },
            {
              "type": "null"
            }
          ]
        },
        "libs": {
          "anyOf": [
            {
              "maxItems": 16,
              "type": "array",
              "items": {
                "anyOf": [
                  {
                    "type": "string",
                    "enum": [
                      "uplot@1"
                    ]
                  },
                  {
                    "type": "string",
                    "maxLength": 2048,
                    "pattern": "^https:\\/\\/\\S+$"
                  },
                  {
                    "type": "object",
                    "properties": {
                      "name": {
                        "type": "string",
                        "pattern": "^[A-Za-z0-9@/._+-]{1,80}$"
                      },
                      "version": {
                        "type": "string",
                        "pattern": "^[A-Za-z0-9._+-]{1,40}$"
                      },
                      "sha256": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{64}$"
                      },
                      "source": {
                        "type": "string",
                        "maxLength": 2048,
                        "pattern": "^https:\\/\\/[^\\s\"'<>\\\\]+$"
                      },
                      "finalUrl": {
                        "type": "string",
                        "maxLength": 2048,
                        "pattern": "^https:\\/\\/[^\\s\"'<>\\\\]+$"
                      },
                      "bytes": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 67108864
                      }
                    },
                    "required": [
                      "name",
                      "sha256"
                    ],
                    "additionalProperties": false
                  }
                ]
              },
              "description": "Interactive mode: scripts loaded before the deck and slide scripts, in order: an https CDN URL of a classic (UMD/IIFE) build, which the server downloads once and stores (vendoring); a bundled id (see the guide); or { name, version, sha256, source } as get_presentation returns it."
            },
            {
              "type": "null"
            }
          ]
        },
        "script": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 524288,
              "description": "Interactive mode: deck-level JavaScript run once in the global scope, after libs and before the slide scripts, only after the owner approves it. Max 512 KB."
            },
            {
              "type": "null"
            }
          ]
        },
        "slide_order": {
          "description": "New order: exactly the current slide ids, each once.",
          "maxItems": 200,
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 40
          }
        }
      },
      "required": [
        "presentation_id",
        "expected_revision"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "title": "Update presentation metadata",
      "readOnlyHint": false,
      "destructiveHint": false,
      "idempotentHint": false,
      "openWorldHint": false
    }
  },
  {
    "name": "update_slides",
    "title": "Insert, edit or remove slides",
    "description": "Edits slides by id in one call: each upsert with an existing id changes only the fields sent (null clears css, notes, section or duration_hint_sec); a new or missing id inserts a slide after `after` (\"start\", \"end\" or a slide id; default end); then `remove` deletes ids. Requires expected_revision from get_presentation. Old revisions are kept, so removals can be undone by the owner.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "presentation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "description": "Id returned by create_presentation or list_presentations."
        },
        "expected_revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991,
          "description": "The revision you last read (get_presentation `revision`). The call fails with REVISION_CONFLICT if someone changed the presentation since."
        },
        "upsert": {
          "description": "Slides to insert or edit, applied in order. A new slide needs `html`.",
          "maxItems": 200,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "description": "Existing id: change only the fields sent. New or missing id: insert a new slide.",
                "type": "string",
                "pattern": "^[a-z0-9-]{1,40}$"
              },
              "after": {
                "description": "Insert or move after this slide id, or \"start\" / \"end\" (default \"end\" for new slides).",
                "type": "string",
                "maxLength": 40
              },
              "title": {
                "type": "string",
                "maxLength": 200
              },
              "html": {
                "type": "string",
                "maxLength": 262144
              },
              "css": {
                "description": "null removes the slide CSS.",
                "anyOf": [
                  {
                    "type": "string",
                    "maxLength": 65536
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "notes": {
                "description": "null removes the notes.",
                "anyOf": [
                  {
                    "type": "string",
                    "maxLength": 16384
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "section": {
                "anyOf": [
                  {
                    "type": "string",
                    "maxLength": 100
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "duration_hint_sec": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 3600
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "script": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 131072,
                    "description": "Interactive mode: the slide's JavaScript, run only after the owner approves it (see the guide). Max 128 KB."
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "additionalProperties": false
          }
        },
        "remove": {
          "description": "Slide ids to remove (applied after upsert).",
          "maxItems": 200,
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 40
          }
        }
      },
      "required": [
        "presentation_id",
        "expected_revision"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "title": "Insert, edit or remove slides",
      "readOnlyHint": false,
      "destructiveHint": true,
      "idempotentHint": false,
      "openWorldHint": false
    }
  },
  {
    "name": "delete_presentation",
    "title": "Move a presentation to the trash",
    "description": "Moves a presentation to the trash. The owner can restore it from the panel for 30 days; there is no permanent deletion from here. Only call it when the user explicitly asked to delete this presentation.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "presentation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "description": "Id returned by create_presentation or list_presentations."
        }
      },
      "required": [
        "presentation_id"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "title": "Move a presentation to the trash",
      "readOnlyHint": false,
      "destructiveHint": true,
      "idempotentHint": false,
      "openWorldHint": false
    }
  },
  {
    "name": "add_asset",
    "title": "Upload an image",
    "description": "Uploads an image (PNG, JPEG, WebP, AVIF or GIF) for a presentation as source { base64, media_type } (at most 1 MB decoded) or source { url } (an https URL the server downloads once, at most 8 MB) and returns its ref (asset:<sha256>) to use in <img src> or background-image:url(); then save the slide with update_slides. Uploading the same bytes twice returns the same ref. SVG: write it inline in the slide instead.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "presentation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "description": "Id returned by create_presentation or list_presentations."
        },
        "filename": {
          "description": "Informational, e.g. \"logo.png\".",
          "type": "string",
          "maxLength": 255
        },
        "source": {
          "type": "object",
          "properties": {
            "base64": {
              "description": "File content in base64, at most 1 MB once decoded.",
              "type": "string",
              "maxLength": 1500000
            },
            "media_type": {
              "description": "image/png, image/jpeg, image/webp, image/avif or image/gif (checked against the content).",
              "type": "string",
              "maxLength": 100
            },
            "url": {
              "description": "An https URL of the image instead of base64: the server downloads it once and stores it (at most 8 MB).",
              "type": "string",
              "maxLength": 2048
            }
          },
          "additionalProperties": false,
          "description": "The image: { base64, media_type } or { url }."
        }
      },
      "required": [
        "presentation_id",
        "source"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "title": "Upload an image",
      "readOnlyHint": false,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    }
  },
  {
    "name": "get_presentation_links",
    "title": "Get presentation links",
    "description": "Returns the URLs of a presentation: urls.present (opens the player; give it to the user) and urls.manage (the presentation's page in the owner's panel, where the owner reviews and approves its scripts), plus its public links (none in this version). It does not create links.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "presentation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "description": "Id returned by create_presentation or list_presentations."
        }
      },
      "required": [
        "presentation_id"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "title": "Get presentation links",
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    }
  },
  {
    "name": "import_html_deck",
    "title": "Import an HTML artifact as a presentation",
    "description": "Creates a presentation from a whole HTML document as you would write it in an artifact (inline <style>, Google Fonts <link>, CDN <script src>, https images, inline scripts). The server splits it into slides (data-slide, class \"slide\", sibling <section>s, then <h1>/<h2>, else one slide), downloads every external resource once and stores it, and returns presentation_id, urls, the heuristic used, a vendoring report and warnings. Scripts never run until the owner approves them (interactive.approve_url). Use it when the user asks to send an existing artifact to PPTaken; prefer create_presentation when you write a new deck for PPTaken.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "html": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2097152,
          "description": "The complete HTML document of the artifact (<!doctype html>…</html>), as is: CDN scripts, Google Fonts links, stylesheets and https images are vendored. Max 2 MB."
        },
        "title": {
          "description": "Overrides <title>.",
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "lang": {
          "type": "string",
          "pattern": "^[A-Za-z]{2,3}(-[A-Za-z0-9]{2,8})*$",
          "description": "BCP-47 language tag, e.g. \"en\" or \"es-PE\"."
        },
        "aspect_ratio": {
          "description": "\"16:9\" (default) or \"4:3\".",
          "type": "string",
          "enum": [
            "16:9",
            "4:3"
          ]
        },
        "split": {
          "description": "How to split the body into slides. \"auto\" (default) tries in order: elements with data-slide, elements with class \"slide\", sibling <section>s, then <h1>/<h2> boundaries, else one slide.",
          "type": "string",
          "enum": [
            "auto",
            "slides",
            "headings",
            "single"
          ]
        },
        "idempotency_key": {
          "description": "Repeating the call with the same key returns the first result.",
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      },
      "required": [
        "html"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "title": "Import an HTML artifact as a presentation",
      "readOnlyHint": false,
      "destructiveHint": false,
      "idempotentHint": false,
      "openWorldHint": true
    }
  }
]