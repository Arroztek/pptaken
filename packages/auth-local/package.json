{
  "name": "@pptaken/auth-local",
  "version": "0.0.0",
  "description": "PPTaken auth adapter for self-hosted instances: single owner, install code, sessions, API tokens, CSRF, rate limits and secrets.",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./contract": {
      "types": "./dist/contract.d.ts",
      "default": "./dist/contract.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@pptaken/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "vitest": "5.1.0"
  }
}
