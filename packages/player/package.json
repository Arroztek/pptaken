{
  "name": "@pptaken/player",
  "version": "0.0.0",
  "description": "PPTaken presentation player engine: deck document builder, in-iframe runtime, postMessage protocol and shell.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./shell": {
      "types": "./dist/shell.d.ts",
      "default": "./dist/shell.js"
    },
    "./protocol": {
      "types": "./dist/protocol.d.ts",
      "default": "./dist/protocol.js"
    },
    "./laser": {
      "types": "./dist/laser.d.ts",
      "default": "./dist/laser.js"
    },
    "./navigation": {
      "types": "./dist/navigation.d.ts",
      "default": "./dist/navigation.js"
    },
    "./builder": {
      "types": "./dist/builder.d.ts",
      "default": "./dist/builder.js"
    },
    "./presenter": {
      "types": "./dist/presenter.d.ts",
      "default": "./dist/presenter.js"
    },
    "./sync": {
      "types": "./dist/sync.d.ts",
      "default": "./dist/sync.js"
    },
    "./pace": {
      "types": "./dist/pace.d.ts",
      "default": "./dist/pace.js"
    },
    "./notes": {
      "types": "./dist/notes.d.ts",
      "default": "./dist/notes.js"
    },
    "./offline": {
      "types": "./dist/offline.d.ts",
      "default": "./dist/offline.js"
    },
    "./offline-cache": {
      "types": "./dist/offline-cache.d.ts",
      "default": "./dist/offline-cache.js"
    },
    "./offline-client": {
      "types": "./dist/offline-client.d.ts",
      "default": "./dist/offline-client.js"
    },
    "./error-report": {
      "types": "./dist/error-report.d.ts",
      "default": "./dist/error-report.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.runtime.json && tsc -p tsconfig.sw.json && node scripts/build-runtime.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.runtime.json --noEmit && tsc -p tsconfig.sw.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run",
    "test:browser": "pnpm run build && node browser/run.mjs",
    "test:scripts": "pnpm run build && node browser/scripts.mjs"
  },
  "dependencies": {
    "@pptaken/schema": "workspace:*"
  },
  "devDependencies": {
    "@pptaken/sanitizer": "workspace:*",
    "@types/node": "22.20.5"
  }
}
