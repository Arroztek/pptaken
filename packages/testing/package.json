{
  "name": "@pptaken/testing",
  "version": "0.0.0",
  "description": "PPTaken test kit: port contract suites, in-memory implementations of every port and data factories.",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./pptx": {
      "types": "./dist/pptx.d.ts",
      "default": "./dist/pptx.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@pptaken/core": "workspace:*",
    "@pptaken/schema": "workspace:*",
    "@pptaken/zip": "workspace:*"
  },
  "peerDependencies": {
    "vitest": "^5.1.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "vitest": "5.1.0"
  }
}
